# Obsidian Graph MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Voyage AI API key
# Get one at https://dashboard.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional: Voyage embedding model (default: voyage-context-4)
# Must be a contextualized chunk embedding model with 1024-dim output.
# Changing the model requires a full re-index, because embeddings from
# different models are not comparable:
#   docker exec -i obsidian-graph .venv/bin/python -m src.indexer
# VOYAGE_MODEL=voyage-context-4

# --- Multi-format consulting graph (Gemini embeddings) ---
# Required for scripts/index_consulting.py + search_consulting.py
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Standalone consulting pgvector (docker-compose.consulting.yml). Defaults shown.
# CONSULTING_ROOT=/Users/drewburchfield/dev/consulting
# CONSULTING_PG_HOST=localhost
# CONSULTING_PG_PORT=5434
# CONSULTING_PG_DB=consulting_graph
# Gemini free-tier-safe embedding rate (requests/min)
# EMBEDDING_REQUESTS_PER_MINUTE=100

# Required: Path to your Obsidian vault
# Use absolute path on your system
# Cloud sync paths work (iCloud, Google Drive, Dropbox, OneDrive)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Required: Database password
# Generate a secure password:
#   openssl rand -base64 36
POSTGRES_PASSWORD=your_secure_password_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: File watching configuration
# OBSIDIAN_WATCH_ENABLED=true          # Enable/disable file watching
# OBSIDIAN_DEBOUNCE_SECONDS=30         # Wait time before re-indexing after edits

# Optional: Polling mode for cloud-synced vaults
# Auto-enabled when running in Docker or when vault is in a cloud sync folder
# OBSIDIAN_WATCH_USE_POLLING=          # Leave empty for auto-detect, or set true/false
# OBSIDIAN_WATCH_POLLING_INTERVAL=30   # Seconds between directory scans (default: 30)
